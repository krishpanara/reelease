APP_NAME=Social Ominfinitive
NODE_ENV=development
# The Next.js app runs on 3000, so the API uses 5000
PORT=5000

# Required by the license check (value from the vendor documentation)
APP_ID=Uk01OUg5SlpFRQ==
# Public URL of this API (used for media links and the license check)
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
SERVER_ADDR=127.0.0.1

MONGODB_URI=mongodb://127.0.0.1:27017/reelease-ai
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# true blocks all create/update/delete actions (for public demos only)
APP_DEMO_MODE=false

# Admin Credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@reeleaseai.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Reelease Admin

DEFAULT_USER_EMAIL=john@reeleaseai.com
DEFAULT_USER_PASSWORD=123456789
DEFAULT_USER_NAME=John Doe

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_ENCRYPTION=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_SECRET=
RAZORPAY_KEY_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=
